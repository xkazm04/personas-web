{
  "openapi": "3.1.0",
  "info": {
    "title": "personas-web API routes",
    "version": "0.1.0",
    "description": "Request and response shapes of every handler under src/app/api. The gate, secret and abuse control of each route are in docs/threat-model.md (## Routes); this file is the shape an agent needs before writing a caller. src/lib/apiSchemaCoverage.test.ts fails when a route, a method or an allowlist here drifts from the handler; src/lib/apiSchemaStatuses.test.ts fails when a handler sends a literal status its path does not document; src/lib/apiSchemaExamples.test.ts fails when a JSON body has no example or its example breaks its own schema."
  },
  "servers": [{ "url": "/" }],
  "tags": [
    { "name": "orchestrator", "description": "Session-gated relays to the external orchestrator (NEXT_PUBLIC_ORCHESTRATOR_URL)." },
    { "name": "community", "description": "Anonymous roadmap voting, boosts, comments and requests. Supabase when configured, a local JSON file otherwise." },
    { "name": "site", "description": "Public reads and redirects." }
  ],
  "paths": {
    "/api/orchestrator/{path}": {
      "parameters": [
        { "name": "path", "in": "path", "required": true, "description": "Catch-all upstream path, relayed to the orchestrator host. Traversal or an origin change is refused as bad_path.", "schema": { "type": "string" } },
        { "$ref": "#/components/parameters/UserToken" }
      ],
      "get": { "tags": ["orchestrator"], "summary": "Relay a GET to the orchestrator", "responses": { "2XX": { "$ref": "#/components/responses/RelayOk" }, "400": { "$ref": "#/components/responses/BadPath" }, "401": { "$ref": "#/components/responses/Unauthenticated" }, "499": { "$ref": "#/components/responses/ClientClosed" }, "501": { "$ref": "#/components/responses/NotOnDesktop" }, "502": { "$ref": "#/components/responses/UpstreamUnreachable" }, "503": { "$ref": "#/components/responses/Unavailable" }, "504": { "$ref": "#/components/responses/UpstreamTimeout" } } },
      "post": { "tags": ["orchestrator"], "summary": "Relay a POST to the orchestrator", "requestBody": { "$ref": "#/components/requestBodies/JsonRelay" }, "responses": { "2XX": { "$ref": "#/components/responses/RelayOk" }, "400": { "$ref": "#/components/responses/BadPath" }, "401": { "$ref": "#/components/responses/Unauthenticated" }, "499": { "$ref": "#/components/responses/ClientClosed" }, "501": { "$ref": "#/components/responses/NotOnDesktop" }, "502": { "$ref": "#/components/responses/UpstreamUnreachable" }, "503": { "$ref": "#/components/responses/Unavailable" }, "504": { "$ref": "#/components/responses/UpstreamTimeout" } } },
      "put": { "tags": ["orchestrator"], "summary": "Relay a PUT to the orchestrator", "requestBody": { "$ref": "#/components/requestBodies/JsonRelay" }, "responses": { "2XX": { "$ref": "#/components/responses/RelayOk" }, "400": { "$ref": "#/components/responses/BadPath" }, "401": { "$ref": "#/components/responses/Unauthenticated" }, "499": { "$ref": "#/components/responses/ClientClosed" }, "501": { "$ref": "#/components/responses/NotOnDesktop" }, "502": { "$ref": "#/components/responses/UpstreamUnreachable" }, "503": { "$ref": "#/components/responses/Unavailable" }, "504": { "$ref": "#/components/responses/UpstreamTimeout" } } },
      "delete": { "tags": ["orchestrator"], "summary": "Relay a DELETE to the orchestrator", "responses": { "2XX": { "$ref": "#/components/responses/RelayOk" }, "400": { "$ref": "#/components/responses/BadPath" }, "401": { "$ref": "#/components/responses/Unauthenticated" }, "499": { "$ref": "#/components/responses/ClientClosed" }, "501": { "$ref": "#/components/responses/NotOnDesktop" }, "502": { "$ref": "#/components/responses/UpstreamUnreachable" }, "503": { "$ref": "#/components/responses/Unavailable" }, "504": { "$ref": "#/components/responses/UpstreamTimeout" } } },
      "patch": { "tags": ["orchestrator"], "summary": "Relay a PATCH to the orchestrator", "requestBody": { "$ref": "#/components/requestBodies/JsonRelay" }, "responses": { "2XX": { "$ref": "#/components/responses/RelayOk" }, "400": { "$ref": "#/components/responses/BadPath" }, "401": { "$ref": "#/components/responses/Unauthenticated" }, "499": { "$ref": "#/components/responses/ClientClosed" }, "501": { "$ref": "#/components/responses/NotOnDesktop" }, "502": { "$ref": "#/components/responses/UpstreamUnreachable" }, "503": { "$ref": "#/components/responses/Unavailable" }, "504": { "$ref": "#/components/responses/UpstreamTimeout" } } }
    },
    "/api/events/stream": {
      "get": {
        "tags": ["orchestrator"],
        "summary": "Server-sent event bus stream",
        "parameters": [{ "$ref": "#/components/parameters/UserToken" }],
        "responses": {
          "200": { "description": "Event stream relayed from the orchestrator.", "content": { "text/event-stream": { "schema": { "type": "string" } } } },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "499": { "description": "Client closed the connection before the upstream answered." },
          "501": { "$ref": "#/components/responses/NotOnDesktop" },
          "502": { "description": "Upstream unreachable." },
          "503": { "$ref": "#/components/responses/Unavailable" },
          "504": { "$ref": "#/components/responses/UpstreamTimeout" }
        }
      }
    },
    "/api/executions/{id}/stream": {
      "get": {
        "tags": ["orchestrator"],
        "summary": "Server-sent stream of one execution's output",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "description": "Execution id, percent-encoded before relay. Empty, '.' and '..' are refused as bad_path.", "schema": { "type": "string", "minLength": 1 } },
          { "$ref": "#/components/parameters/UserToken" }
        ],
        "responses": {
          "200": { "description": "Execution output relayed from the orchestrator.", "content": { "text/event-stream": { "schema": { "type": "string" } } } },
          "400": { "$ref": "#/components/responses/BadPath" },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "499": { "description": "Client closed the connection before the upstream answered." },
          "501": { "$ref": "#/components/responses/NotOnDesktop" },
          "502": { "description": "Upstream unreachable." },
          "503": { "$ref": "#/components/responses/Unavailable" },
          "504": { "$ref": "#/components/responses/UpstreamTimeout" }
        }
      }
    },
    "/api/votes": {
      "get": {
        "tags": ["community"],
        "summary": "Vote counts, the caller's votes and shipped features",
        "parameters": [{ "name": "voterId", "in": "query", "required": false, "description": "Marks which features this voter has voted for. Never returns email.", "schema": { "type": "string" } }],
        "responses": {
          "200": {
            "description": "Counts per feature id.",
            "content": { "application/json": { "schema": {
              "type": "object",
              "required": ["counts", "userVotes", "shipped"],
              "properties": {
                "counts": { "type": "object", "additionalProperties": { "type": "integer" } },
                "userVotes": { "type": "array", "items": { "$ref": "#/components/schemas/FeatureId" } },
                "shipped": { "type": "array", "items": { "type": "object", "properties": { "feature_id": { "type": "string" }, "changelog": { "type": "string" }, "link": { "type": "string" }, "shipped_at": { "type": "string" } } } }
              }
            },
            "example": { "counts": { "macos": 42, "dashboard": 17, "enterprise": 5 }, "userVotes": ["macos"], "shipped": [] } } }
          },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "500": { "$ref": "#/components/responses/ServerError" },
          "503": { "$ref": "#/components/responses/StoreUnavailable" }
        }
      },
      "post": {
        "tags": ["community"],
        "summary": "Toggle the caller's vote for a feature",
        "requestBody": { "required": true, "description": "At most 10 KiB.", "content": { "application/json": { "schema": {
          "type": "object",
          "required": ["featureId", "voterId"],
          "properties": { "featureId": { "$ref": "#/components/schemas/FeatureId" }, "voterId": { "$ref": "#/components/schemas/VoterId" } }
        }, "example": { "featureId": "macos", "voterId": "v_3f9a2c7e1b4d8f60" } } } },
        "responses": {
          "200": { "description": "Vote added or removed.", "content": { "application/json": { "schema": { "type": "object", "required": ["action"], "properties": { "action": { "enum": ["added", "removed"] } } }, "example": { "action": "added" } } } },
          "400": { "$ref": "#/components/responses/Invalid" },
          "413": { "$ref": "#/components/responses/TooLarge" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "500": { "$ref": "#/components/responses/ServerError" },
          "503": { "$ref": "#/components/responses/StoreUnavailable" }
        }
      }
    },
    "/api/feature-boosts": {
      "get": {
        "tags": ["community"],
        "summary": "Boost totals per feature",
        "responses": {
          "200": { "description": "Summed boost weight per feature id.", "content": { "application/json": { "schema": { "type": "object", "required": ["totals"], "properties": { "totals": { "type": "object", "additionalProperties": { "type": "integer" } } } }, "example": { "totals": { "macos": 40, "enterprise": 15 } } } } },
          "500": { "$ref": "#/components/responses/ServerError" },
          "503": { "$ref": "#/components/responses/StoreUnavailable" }
        }
      },
      "post": {
        "tags": ["community"],
        "summary": "Record a Ko-fi boost",
        "requestBody": { "required": true, "description": "At most 4 KiB. weight must equal tierValue.", "content": { "application/json": { "schema": {
          "type": "object",
          "required": ["featureId", "voterId", "tierValue", "weight"],
          "properties": {
            "featureId": { "$ref": "#/components/schemas/FeatureId" },
            "voterId": { "$ref": "#/components/schemas/VoterId" },
            "tierValue": { "$ref": "#/components/schemas/BoostTier" },
            "weight": { "$ref": "#/components/schemas/BoostTier" }
          }
        }, "example": { "featureId": "enterprise", "voterId": "v_3f9a2c7e1b4d8f60", "tierValue": 15, "weight": 15 } } } },
        "responses": {
          "200": { "description": "Boost recorded. Read GET for the updated totals.", "content": { "application/json": { "schema": { "type": "object", "required": ["ok"], "properties": { "ok": { "const": true } } }, "example": { "ok": true } } } },
          "400": { "$ref": "#/components/responses/Invalid" },
          "413": { "$ref": "#/components/responses/TooLarge" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "500": { "$ref": "#/components/responses/ServerError" },
          "503": { "$ref": "#/components/responses/StoreUnavailable" }
        }
      }
    },
    "/api/feature-comments": {
      "get": {
        "tags": ["community"],
        "summary": "The newest 500 comments across features, oldest first",
        "responses": {
          "200": { "description": "The newest 500 comments, oldest first.", "content": { "application/json": { "schema": { "type": "object", "required": ["comments"], "properties": { "comments": { "type": "array", "items": { "$ref": "#/components/schemas/Comment" } } } }, "example": { "comments": [
            { "id": "0b9f1c2e-4a7d-4e1b-9c3a-5d6e7f8a9b0c", "featureId": "dashboard", "parentId": null, "author": "Ada", "text": "Would love a dark theme here.", "timestamp": 1760313600000 },
            { "id": "6c1d2e3f-8a9b-4c0d-8e1f-2a3b4c5d6e7f", "featureId": "dashboard", "parentId": "0b9f1c2e-4a7d-4e1b-9c3a-5d6e7f8a9b0c", "author": "Lin", "text": "+1, especially for the charts.", "timestamp": 1760317200000 }
          ] } } } },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "500": { "$ref": "#/components/responses/ServerError" },
          "503": { "$ref": "#/components/responses/StoreUnavailable" }
        }
      },
      "post": {
        "tags": ["community"],
        "summary": "Add a comment or a one-level reply",
        "requestBody": { "required": true, "description": "At most 8 KiB. A reply's parent must be a top-level comment.", "content": { "application/json": { "schema": {
          "type": "object",
          "required": ["featureId", "text", "author"],
          "properties": {
            "featureId": { "$ref": "#/components/schemas/FeatureId" },
            "text": { "type": "string", "minLength": 1, "maxLength": 300, "description": "Trimmed before the length check." },
            "author": { "type": "string", "minLength": 1, "maxLength": 64, "description": "Trimmed before the length check." },
            "parentId": { "type": ["string", "null"], "format": "uuid" }
          }
        }, "example": { "featureId": "dashboard", "text": "Would love a dark theme here.", "author": "Ada", "parentId": null } } } },
        "responses": {
          "200": { "description": "Comment saved; body carries the stored row.", "content": { "application/json": { "schema": { "type": "object", "required": ["comment"], "properties": { "comment": { "$ref": "#/components/schemas/Comment" } } }, "example": { "comment": { "id": "0b9f1c2e-4a7d-4e1b-9c3a-5d6e7f8a9b0c", "featureId": "dashboard", "parentId": null, "author": "Ada", "text": "Would love a dark theme here.", "timestamp": 1760313600000 } } } } },
          "400": { "$ref": "#/components/responses/Invalid" },
          "413": { "$ref": "#/components/responses/TooLarge" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "500": { "$ref": "#/components/responses/ServerError" },
          "503": { "$ref": "#/components/responses/StoreUnavailable" }
        }
      }
    },
    "/api/feature-requests": {
      "post": {
        "tags": ["community"],
        "summary": "Save a free-text feature request",
        "requestBody": { "required": true, "description": "At most 4 KiB.", "content": { "application/json": { "schema": {
          "type": "object",
          "required": ["text"],
          "properties": { "text": { "type": "string", "minLength": 1, "maxLength": 1000, "description": "Trimmed before the length check." } }
        }, "example": { "text": "Export execution logs as CSV." } } } },
        "responses": {
          "200": { "description": "Saved.", "content": { "application/json": { "schema": { "type": "object", "required": ["saved"], "properties": { "saved": { "const": true } } }, "example": { "saved": true } } } },
          "400": { "$ref": "#/components/responses/Invalid" },
          "413": { "$ref": "#/components/responses/TooLarge" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/waitlist": {
      "get": {
        "tags": ["community"],
        "summary": "Signup counts per platform",
        "responses": {
          "200": { "description": "One count per platform.", "content": { "application/json": { "schema": { "type": "object", "required": ["counts"], "properties": { "counts": { "type": "object", "additionalProperties": { "type": "integer" } } } }, "example": { "counts": { "macos": 412, "windows": 230, "linux": 57 } } } } },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "503": { "$ref": "#/components/responses/CodedError" }
        }
      },
      "post": {
        "tags": ["community"],
        "summary": "Join the waitlist",
        "requestBody": { "required": true, "content": { "application/json": { "schema": {
          "type": "object",
          "required": ["email", "platform"],
          "properties": {
            "email": { "type": "string", "format": "email", "description": "Trimmed and lower-cased before validation." },
            "platform": { "$ref": "#/components/schemas/WaitlistPlatform" },
            "earlyBeta": { "type": "boolean" }
          }
        }, "example": { "email": "ada@example.com", "platform": "macos", "earlyBeta": true } } } },
        "responses": {
          "200": { "description": "Added, or already present (duplicate: true).", "content": { "application/json": { "schema": { "type": "object", "required": ["message"], "properties": { "message": { "type": "string" }, "count": { "type": "integer" }, "duplicate": { "const": true } } }, "example": { "message": "Added to waitlist", "count": 413 } } } },
          "400": { "$ref": "#/components/responses/CodedError" },
          "413": { "$ref": "#/components/responses/TooLarge" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "503": { "$ref": "#/components/responses/CodedError" }
        }
      }
    },
    "/api/roadmap": {
      "get": {
        "tags": ["site"],
        "summary": "Roadmap items, read-only",
        "responses": {
          "200": { "description": "Items from Supabase, or an empty list with source none when it is not configured.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RoadmapResponse" }, "example": { "items": [{ "id": "r1", "name": "Team workspaces", "description": "Share personas across a team.", "status": "in_progress", "priority": "now", "sort_order": 1 }], "source": "supabase" } } } },
          "502": { "description": "Supabase answered with an error; body is an empty list with source error.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RoadmapResponse" }, "example": { "items": [], "source": "error" } } } }
        }
      }
    },
    "/api/download": {
      "get": {
        "tags": ["site"],
        "summary": "Redirect to the latest release artifact",
        "description": "The target is validated once at module load (src/lib/release.ts) and never taken from the request.",
        "responses": {
          "307": { "description": "Redirect to the release URL, or to /#download when none is configured." }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "UserToken": { "name": "X-User-Token", "in": "header", "required": true, "description": "Supabase access token, verified against /auth/v1/user before the team key is attached.", "schema": { "type": "string" } }
    },
    "requestBodies": {
      "JsonRelay": { "required": false, "description": "Relayed as-is to the orchestrator.", "content": { "application/json": { "schema": {} } } }
    },
    "schemas": {
      "FeatureId": { "description": "FEATURE_IDS in src/lib/feature-ids.ts.", "enum": ["macos", "dashboard", "enterprise"] },
      "VoterId": { "description": "Anonymous client-generated id (isValidVoterId in src/lib/validation.ts).", "type": "string", "pattern": "^[A-Za-z0-9_-]{16,64}$" },
      "BoostTier": { "description": "ALLOWED_TIERS in src/app/api/feature-boosts/route.ts.", "enum": [5, 15, 25] },
      "WaitlistPlatform": { "description": "VALID_PLATFORMS in src/app/api/waitlist/route.ts.", "enum": ["macos", "windows", "linux"] },
      "Comment": {
        "type": "object",
        "required": ["id", "featureId", "parentId", "author", "text", "timestamp"],
        "properties": {
          "id": { "type": "string" },
          "featureId": { "type": "string" },
          "parentId": { "type": ["string", "null"] },
          "author": { "type": "string" },
          "text": { "type": "string" },
          "timestamp": { "type": "integer", "description": "Epoch milliseconds." }
        }
      },
      "RoadmapResponse": {
        "type": "object",
        "required": ["items", "source"],
        "properties": {
          "items": { "type": "array", "description": "RoadmapItem rows (src/components/sections/roadmap/types.ts): id, name, description, status, priority, sort_order.", "items": { "type": "object" } },
          "source": { "enum": ["supabase", "none", "error"] }
        }
      },
      "Error": { "type": "object", "required": ["error"], "properties": { "error": { "type": "string" } } },
      "CodedError": { "type": "object", "required": ["error", "code"], "properties": { "error": { "type": "string" }, "code": { "type": "string", "description": "ApiErrorCode in src/lib/server/request.ts; never reworded." } } }
    },
    "responses": {
      "Invalid": { "description": "A field failed validation.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "error": "Invalid feature ID" } } } },
      "CodedError": { "description": "Refusal with a stable machine code.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CodedError" }, "example": { "error": "Invalid email format", "code": "invalid_email" } } } },
      "TooLarge": { "description": "Body over the route's byte limit.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "error": "Payload too large" } } } },
      "RateLimited": { "description": "Per-IP in-memory rate limit hit." },
      "StoreUnavailable": { "description": "A production deployment has no SUPABASE_SERVICE_ROLE_KEY, so the store refuses rather than write through the anon role (src/lib/supabase-admin.ts).", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CodedError" }, "example": { "error": "The store is temporarily unavailable", "code": "store_unavailable" } } } },
      "ServerError": { "description": "Store read or write failed.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "error": "Failed to record vote" } } } },
      "BadPath": { "description": "Path refused before relay (bad_path).", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "error": "bad_path" } } } },
      "Unauthenticated": { "description": "X-User-Token missing or not a live session (unauthenticated).", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "error": "unauthenticated" } } } },
      "NotOnDesktop": { "description": "ORCHESTRATOR_TARGET=desktop serves no such endpoint (not_on_desktop).", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "error": "not_on_desktop", "method": "GET", "path": "/api/events/stream" } } } },
      "Unavailable": { "description": "Orchestrator not configured or auth backend unreachable (orchestrator_not_configured, auth_unavailable).", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "error": "orchestrator_not_configured" } } } },
      "RelayOk": { "description": "Upstream JSON answer, served with nosniff and a sandbox CSP." },
      "ClientClosed": { "description": "Client closed the connection before the upstream answered." },
      "UpstreamUnreachable": { "description": "Upstream unreachable (upstream_unreachable).", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "error": "upstream_unreachable" } } } },
      "UpstreamTimeout": { "description": "The orchestrator did not answer within UPSTREAM_TIMEOUT_MS (src/app/api/orchestrator/upstreamDeadline.ts); a stream relay waits only for its headers (upstream_timeout).", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "error": "upstream_timeout" } } } }
    }
  }
}
