{
  "name": "personas-web",
  "version": "0.1.0",
  "description": "Marketing site, demo dashboard, and API routes for Personas — a platform for building and orchestrating multi-agent AI pipelines.",
  "private": true,
  "license": "MIT",
  "keywords": [
    "personas",
    "ai-agents",
    "agent-orchestration",
    "nextjs",
    "react",
    "typescript",
    "tailwindcss",
    "supabase"
  ],
  "scripts": {
    "dev": "next dev",
    "dev:inspect": "cross-env DEV_INSPECT=1 next dev",
    "build": "next build",
    "analyze": "next experimental-analyze",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "check:field": "node scripts/check-field-budget.mjs",
    "start": "next start",
    "lint": "eslint --max-warnings 5",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:cov": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check:sync-rows": "node scripts/check-sync-rows.mjs",
    "check:connectors": "node scripts/generate-connectors.mjs --check",
    "check:use-case-corpus": "node scripts/compile-use-case-corpus.mjs --check",
    "check:guide-content": "node scripts/check-guide-content.mjs",
    "check:guide-coverage": "node scripts/check-guide-coverage.mjs",
    "check:guide-translations": "node scripts/i18n/check-guide-translations.mjs",
    "check:i18n-coverage": "node scripts/check-i18n-coverage.mjs",
    "check:i18n-encoding": "node scripts/check-i18n-encoding.mjs",
    "check:i18n-ledger": "node scripts/i18n/ui-ledger.mjs --check",
    "i18n:ledger": "node scripts/i18n/ui-ledger.mjs --update",
    "copy:check": "node .claude/skills/native-copy/scripts/copy-check.mjs",
    "check:route-coverage": "node scripts/check-route-coverage.mjs",
    "report:i18n-hardcoded": "node scripts/report-hardcoded-ui-strings.mjs",
    "db:migrate": "node scripts/run-voting-migration.mjs",
    "db:migrate:sync": "node scripts/run-sync-migration.mjs",
    "prepare": "node scripts/install-git-hooks.mjs",
    "sync:desktop-facts": "node scripts/sync-desktop-facts.mjs",
    "compile:changelog": "node scripts/compile-changelog.mjs",
    "check:changelog": "node scripts/compile-changelog.mjs --check",
    "sync:connector-setup": "node scripts/sync-connector-setup.mjs"
  },
  "dependencies": {
    "@sentry/nextjs": "^11.6.0",
    "@supabase/supabase-js": "^2.112.2",
    "framer-motion": "^14.1.0",
    "geist": "^1.8.1",
    "lucide-react": "^1.61.0",
    "next": "^16.3.8",
    "react": "^19.2.8",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "shiki": "^4.5.0",
    "swr": "^2.5.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "pg": "^8.23.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.2",
    "vitest": "^5.0.5"
  }
}
