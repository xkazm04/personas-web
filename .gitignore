# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report
/playwright/.cache

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# local data (waitlist, etc.)
/.data

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code local artifacts
/.claude/logs
/.claude/worktrees

# /icon-gen skill scratch output
.icon-gen-work/

# Report output of scripts/guide-i18n-audit.mjs — regenerated on every run.
/scripts/guide-i18n-audit.json

# Next 16.3 writes these on every `next dev` (versioned docs for AI agents).
# Anchored to the repo root so the project's own .claude/CLAUDE.md is untouched.
/AGENTS.md
/CLAUDE.md

# /consult skill log (counts reach the ai-registry signals lane; the log itself stays local)
.ai/consults.jsonl

# BEGIN ai-registry linked skills (managed by ai-registry/scripts/link-skills.mjs)
# The links are machine state; the declaration lives in .ai/manifest.yaml `skills:`.
/.claude/skills/architect
/.claude/skills/consult
/.claude/skills/explorer
/.claude/skills/friend
/.claude/skills/leonardo
/.claude/skills/npm-updates
/.claude/skills/perfect
# END ai-registry linked skills

# BEGIN ai-registry linked skills (managed by ai-registry/scripts/link-registry.mjs)
# Links are machine state; the declarations live in .ai/manifest.yaml (`skills:` and `knowledge.domains`).
/.claude/skills/architect
/.claude/skills/consult
/.claude/skills/explorer
/.claude/skills/friend
/.claude/skills/leonardo
/.claude/skills/npm-updates
